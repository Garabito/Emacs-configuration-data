  ;; ======== 2. Tags automáticos (contextos GTD) ============
(setq org-tag-alist
      '(("@work" . ?w)
        ("@home" . ?h)
        ("@online" . ?o)
        ("@calls" . ?c)
        ("@quick" . ?q)
        ("project" . ?p)))
;; Podrás asignar rápido: C-c C-c sobre un heading o C-c C-q.		
;; ==========================================================
;; ======== 3. org-capture (captura rápida tipo GTD) ========
   (setq org-capture-templates
      '(("i" "Inbox" entry
         ;;(file+headline "~/org/gtd.org" " Inbox")
		 (file+headline "C:/Editors/Emacs/Workspace.emacs/Org.Workspace/Agenda.org" " Inbox")
         "* TODO %?\n%U\n")

        ("t" "Task (Next Action)" entry
         (file+headline "C:/Editors/Emacs/Workspace.emacs/Org.Workspace/Agenda.org" " Next Actions")
         "* TODO %? :@work:\n%U\n")

        ("p" "Project" entry
         (file+headline "C:/Editors/Emacs/Workspace.emacs/Org.Workspace/Agenda.org" " Projects")
         "* TODO %? :project:\n%U\n** NEXT First action\n")

        ("w" "Waiting" entry
         (file+headline "C:/Editors/Emacs/Workspace.emacs/Org.Workspace/Agenda.org" " Waiting")
         "* WAITING %? \n%U\n")

        ("s" "Someday" entry
         (file+headline "C:/Editors/Emacs/Workspace.emacs/Org.Workspace/Agenda.org" " Someday")
         "* %? \n%U\n")))
;; Uso
;; C-c c i → capturar en Inbox
;; C-c c t → acción directa
;; C-c c p → proyecto
;; =================================================
;; ======== 4 Estados TODO (flujo GTD real) ========
(setq org-todo-keywords
      '((sequence "TODO(t)" "NEXT(n)" "WAITING(w)" "|" "DONE(d)" "CANCELLED(c)")))
;; Urgente, no urgente, importante, no importante	  
;;  Lógica:
;;	TODO → no procesada
;;	NEXT → acción ejecutable
;;	WAITING → depende de alguien más
;;	DONE → completada	  
;; =====================================================
;; ======== 5. Org Agenda (el corazón del sistema) ========
(setq org-agenda-custom-commands
      '(("g" "GTD Dashboard"
         ((agenda "")
          (todo "NEXT")
          (tags-todo "@work")
          (tags-todo "@home")
          (todo "WAITING")
          (todo "TODO")))))
;; M-x org-agenda → g
;; ======================================================	 
;; ======== 6  Forzar GTD limpio ========
(defun my/org-project-p ()
  (and (org-get-tags)
       (member "project" (org-get-tags))))

(defun my/org-has-next-action-p ()
  (save-excursion
    (org-map-entries
     (lambda () t)
     "TODO=\"NEXT\"" 'tree)))

(defun my/org-stuck-projects ()
  (org-scan-tags
   '(and (tags "project")
         (not (todo "NEXT")))))

;; ===============================================
;; ======== 7. Separar automáticamente contextos =
;; Autotag según ubicación (opcional más avanzado):
(defun my/org-auto-context ()
  (when (string-match "call\\|phone" (downcase (or (thing-at-point 'line) "")))
    (org-set-tags ":@calls:")))

(add-hook 'org-capture-mode-hook 'my/org-auto-context)
;; ===============================================
;; ======== 8. Revisión semanal (clave GTD) ========
(setq org-agenda-custom-commands
      '(("r" "Weekly Review"
         ((stuck "")
          (tags "project")
          (todo "WAITING")
          (todo "TODO")
          (agenda "")))))
